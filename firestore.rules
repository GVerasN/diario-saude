rules_version = '2';
// Cada pessoa só lê e grava os próprios dados: users/{uid} e tudo abaixo dele.
// Cópia de referência: estas regras são coladas no console do Firebase (Firestore > Regras).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
